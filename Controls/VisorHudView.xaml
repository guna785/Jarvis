<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              x:Class="Visor.Controls.VisorHudView"
             BackgroundColor="Transparent">

    <Grid IgnoreSafeArea="True">
        <Border Stroke="#00D4FF" StrokeThickness="2" Background="#90001525" Margin="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,40,0,40" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#00D4FF" Radius="20" Opacity="0.6" Offset="0,0" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto, *">
                <HorizontalStackLayout Grid.Row="0" Spacing="10" Padding="20,15">
                    <Ellipse x:Name="StatusDot" WidthRequest="12" HeightRequest="12" Fill="#00D4FF" />
                    <Label Text="VISOR CORE :: ONLINE" TextColor="#00D4FF" FontAttributes="Bold" CharacterSpacing="2" FontSize="12"/>
                </HorizontalStackLayout>

                <ScrollView Grid.Row="1" Padding="20">
                    <VerticalStackLayout Spacing="30" HorizontalOptions="Center">

                        <Grid HeightRequest="150" WidthRequest="150">
                            <Ellipse x:Name="OuterRing" Stroke="#8000D4FF" StrokeThickness="2" StrokeDashArray="10,5" />
                            <Ellipse x:Name="MiddleRing" Stroke="#A000D4FF" StrokeThickness="3" StrokeDashArray="20,10" WidthRequest="100" HeightRequest="100" />
                            <Ellipse x:Name="Core" Fill="#00D4FF" WidthRequest="40" HeightRequest="40">
                                <Ellipse.Shadow>
                                    <Shadow Brush="#00D4FF" Radius="30" Opacity="1" />
                                </Ellipse.Shadow>
                            </Ellipse>
                        </Grid>

                        <Label Text="HELLO SIR, SYSTEM IS READY." TextColor="White" HorizontalOptions="Center" />

                        <Button Text="INITIATE SCAN" BackgroundColor="#2000D4FF" TextColor="White" BorderColor="#00D4FF" BorderWidth="1" CornerRadius="0" WidthRequest="200" />
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <BoxView x:Name="Scanline" HeightRequest="1" BackgroundColor="#5000D4FF" VerticalOptions="Start" InputTransparent="True" />
    </Grid>
</ContentView>