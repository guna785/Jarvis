<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"            
             Shell.NavBarIsVisible="False"
             Shell.BackgroundColor="#01050a"             
             Shell.PresentationMode="NotAnimated"
             BackgroundColor="#01050a"
             x:Class="Visor.MainPage">
    <Grid RowDefinitions="*">
        <!-- BASE LEVEL: DEEP SPACE GRADIENT -->
        <BoxView BackgroundColor="#020810" />
        
        <!-- LAYER 1: COMPLEX NEBULA GLOWS -->
        <Ellipse Fill="#003366" WidthRequest="800" HeightRequest="800" VerticalOptions="Center" HorizontalOptions="Center" Opacity="0.3" TranslationY="-100" />
        <Ellipse Fill="#001a33" WidthRequest="600" HeightRequest="600" VerticalOptions="End" HorizontalOptions="Start" Opacity="0.2" TranslationX="-200" TranslationY="200" />
        
        <!-- LAYER 2: HOLOGRAPHIC DATA GRID -->
        <Grid Opacity="0.05" InputTransparent="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <BoxView Grid.Row="1" Grid.Column="1" HorizontalOptions="Center" WidthRequest="1" Color="#00fbff" />
            <BoxView Grid.Row="1" Grid.Column="1" VerticalOptions="Center" HeightRequest="1" Color="#00fbff" />
            
            <Rectangle Grid.Row="1" Grid.Column="1" Stroke="#00fbff" StrokeThickness="0.2" Fill="Transparent" Opacity="0.5" />
        </Grid>

        <!-- LAYER 3: SCANNING PULSE LINE -->
        <BoxView x:Name="ScannerLine" HeightRequest="2" VerticalOptions="Start" HorizontalOptions="Fill" Color="#00fbff" Opacity="0.4">
            <BoxView.Shadow>
                <Shadow Brush="#00fbff" Radius="30" Opacity="1" Offset="0,0" />
            </BoxView.Shadow>
        </BoxView>

        <Grid RowDefinitions="*, auto">
            
            <!-- TOP SECTION: THE Visor CORE (Mark 85 Inspired) -->
            <Grid Grid.Row="0" x:Name="ReactorContainer" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="380" HeightRequest="380">
                
                <!-- OUTER ORBITAL RINGS (TECHNICAL LAYERS) -->
                <Ellipse x:Name="HoloGlow" Fill="#00e6ff" Opacity="0.05" HorizontalOptions="Fill" VerticalOptions="Fill" />
                
                <Ellipse x:Name="DataRing1" Stroke="#00fbff" StrokeThickness="0.5" StrokeDashArray="2, 20" Margin="0" Opacity="0.15"/>
                <Ellipse x:Name="DataRing2" Stroke="#00fbff" StrokeThickness="1" StrokeDashArray="60, 10" Margin="10" Opacity="0.3"/>
                <Ellipse x:Name="TechRing3" Stroke="#00fbff" StrokeThickness="2" StrokeDashArray="1, 8" Margin="25" Opacity="0.2"/>
                
                <!-- PRIMARY TITANIUM RINGS -->
                <Ellipse Stroke="#0A2A47" StrokeThickness="12" Margin="40" Opacity="0.6"/>
                <Ellipse x:Name="QuantumRing" Stroke="#00fbff" StrokeThickness="4" StrokeDashArray="3, 5" Margin="45">
                    <Ellipse.Shadow>
                        <Shadow Brush="#00fbff" Radius="20" Opacity="0.8" />
                    </Ellipse.Shadow>
                </Ellipse>

                <!-- INNER DYNAMIC RINGS -->
                <Ellipse x:Name="InnerRing1" Stroke="#ffcc00" StrokeThickness="1" StrokeDashArray="4, 100" Margin="75" Opacity="0.8" />
                <Ellipse x:Name="InnerRing2" Stroke="#00fbff" StrokeThickness="3" StrokeDashArray="15, 5, 2, 5" Margin="85" Opacity="1" />

                <!-- THE SINGULARITY CORE -->
                <Grid WidthRequest="110" HeightRequest="110" HorizontalOptions="Center" VerticalOptions="Center">
                    <Ellipse Fill="#ffffff" Opacity="0.05" />
                    
                    <!-- CHROMATIC ABERRATION LAYERS (Glitch Effect) -->
                    <Polygon x:Name="GlitchCyan" Points="40,0 80,20 80,65 40,85 0,65 0,20" Fill="#00ffff" Opacity="0" TranslationX="-6" TranslationY="4" WidthRequest="70" HeightRequest="75" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Polygon x:Name="GlitchRed" Points="40,0 80,20 80,65 40,85 0,65 0,20" Fill="#ff0055" Opacity="0" TranslationX="6" TranslationY="-4" WidthRequest="70" HeightRequest="75" HorizontalOptions="Center" VerticalOptions="Center" />

                    <!-- MAIN HOUSING -->
                    <Polygon x:Name="MainCore" Points="40,0 80,20 80,65 40,85 0,65 0,20" Fill="#ffffff" WidthRequest="70" HeightRequest="75" HorizontalOptions="Center" VerticalOptions="Center">
                        <Polygon.Shadow>
                            <Shadow Brush="#ffffff" Radius="60" Opacity="1" />
                        </Polygon.Shadow>
                    </Polygon>

                    <!-- SONAR RIPPLES (Voice Reactive) -->
                    <Ellipse x:Name="SonarRipple1" Stroke="#00fbff" StrokeThickness="4" WidthRequest="90" HeightRequest="90" Opacity="0" />
                    <Ellipse x:Name="SonarRipple2" Stroke="#00fbff" StrokeThickness="2" WidthRequest="90" HeightRequest="90" Opacity="0" />
                </Grid>
            </Grid>

            <!-- BOTTOM SECTION: HOLOGRAPHIC GLASS HUD -->
            <Grid Grid.Row="1" HeightRequest="320" Margin="15,0,15,25">
                
                <!-- GLASSMORPHISM BACKGROUND -->
                <Border BackgroundColor="#0A1F33" Opacity="0.7" Padding="0" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25,2,25,2" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#00fbff" Radius="25" Opacity="0.2" Offset="0,0" />
                    </Border.Shadow>
                </Border>
                
                <!-- HUD DECORATIVE BRACKETS -->
                <Rectangle WidthRequest="40" HeightRequest="2" BackgroundColor="#00fbff" HorizontalOptions="Start" VerticalOptions="Start" Margin="10" />
                <Rectangle WidthRequest="2" HeightRequest="40" BackgroundColor="#00fbff" HorizontalOptions="Start" VerticalOptions="Start" Margin="10" />
                <Rectangle WidthRequest="40" HeightRequest="2" BackgroundColor="#00fbff" HorizontalOptions="End" VerticalOptions="End" Margin="10" />
                <Rectangle WidthRequest="2" HeightRequest="40" BackgroundColor="#00fbff" HorizontalOptions="End" VerticalOptions="End" Margin="10" />

                <Grid RowDefinitions="*, auto">
                    <!-- CHAT HISTORY VIEW -->
                    <CollectionView x:Name="HistoryView" Grid.Row="0" Margin="20,25,20,5" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="4">
                                    <HorizontalStackLayout Spacing="8">
                                        <BoxView WidthRequest="2" HeightRequest="10" Color="#00fbff" VerticalOptions="Center" />
                                        <Label Text="{Binding Role}" TextColor="#00fbff" FontSize="9" CharacterSpacing="2" FontAttributes="Bold" Opacity="0.8" />
                                        <Label Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}]'}" TextColor="#00fbff" FontSize="8" Opacity="0.4" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Message}" TextColor="#e0faff" FontSize="14" LineBreakMode="WordWrap" Margin="10,0,0,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- INTERACTIVE STATUS FOOTER -->
                    <Grid Grid.Row="1" ColumnDefinitions="*, auto" BackgroundColor="#0D2A47" Padding="20,15">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label x:Name="TranscriptLabel" 
                                   Text="STANDBY: SCANNING FOR VOICE INPUT..." 
                                   TextColor="#00fbff" 
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   CharacterSpacing="1"
                                   MaxLines="2"/>
                            <BoxView x:Name="StatusIndicator" HeightRequest="3" WidthRequest="60" Color="#ffcc00" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                        
                        <!-- HUD HARDWARE FLAVOR -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="2">
                            <Label x:Name="SysLoadLabel" Text="SYS_LOAD: 0.04%" TextColor="#00fbff" FontSize="7" Opacity="0.6" HorizontalTextAlignment="End"/>
                            <Label Text="SIGNAL: ENCRYPTED" TextColor="#00fbff" FontSize="7" Opacity="0.6" HorizontalTextAlignment="End"/>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- TOP FLOATING INFO -->
        <Grid VerticalOptions="Start" Padding="30,55" IgnoreSafeArea="True">
            <HorizontalStackLayout HorizontalOptions="Start" Spacing="20">
                <VerticalStackLayout>
                    <Label Text="CORE OS: Visor_M85" TextColor="#00fbff" FontSize="10" CharacterSpacing="2" FontAttributes="Bold"/>
                    <Label x:Name="ClockLabel" Text="00:00:00" TextColor="#ffcc00" FontSize="8" Opacity="0.8" CharacterSpacing="1"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
            
            <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Center">
                <BoxView WidthRequest="1" HeightRequest="20" Color="#00fbff" Margin="0,0,10,0" Opacity="0.5" />
                <Label Text="STARK_IND_PROTOTYPE" TextColor="#00fbff" FontSize="8" VerticalOptions="Center" Opacity="0.5"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- FULL SCREEN SPLASH OVERLAY (Animated GIF) -->
        <Grid x:Name="SplashOverlay" BackgroundColor="#000000" VerticalOptions="Fill" HorizontalOptions="Fill" InputTransparent="False" ZIndex="999">
            <Image Source="visor_splash.png"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   WidthRequest="300"
                   HeightRequest="300" />
            
            <Label x:Name="SplashLoadingText"
                   Text="INITIALIZING SYSTEM..."
                   TextColor="#00fbff"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="0,0,0,50"
                   CharacterSpacing="2" />
        </Grid>


    </Grid>
</ContentPage>
