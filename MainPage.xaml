<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"            
             Shell.NavBarIsVisible="False"
             Shell.BackgroundColor="Transparent"
             Shell.PresentationMode="NotAnimated"
             BackgroundColor="#01050a"
             x:Class="Jarvis.MainPage">
    <Grid BackgroundColor="#01050a">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <BoxView x:Name="ScannerLine" Grid.Row="0" HeightRequest="2" WidthRequest="350" VerticalOptions="Start" HorizontalOptions="Center" Color="#00e6ff" Opacity="0.3">
            <BoxView.Shadow>
                <Shadow Brush="#00e6ff" Radius="15" Opacity="1" />
            </BoxView.Shadow>
        </BoxView>

        <Grid Grid.Row="0" WidthRequest="360" HeightRequest="360" HorizontalOptions="Center" VerticalOptions="Center">

            <Ellipse x:Name="HoloGlow" Fill="#00e6ff" Opacity="0.05" WidthRequest="360" HeightRequest="360">
                <Ellipse.Shadow>
                    <Shadow Brush="#00aaff" Radius="100" Opacity="1" />
                </Ellipse.Shadow>
            </Ellipse>

            <Ellipse x:Name="DataRing1" Stroke="#00e6ff" StrokeThickness="1" StrokeDashArray="2, 8, 2, 40" WidthRequest="300" HeightRequest="300" Opacity="0.6"/>

            <Ellipse Stroke="#003366" StrokeThickness="4" WidthRequest="260" HeightRequest="260" />
            <Ellipse x:Name="DataRing2" Stroke="#00aaff" StrokeThickness="3" StrokeDashArray="30, 5, 2, 5" WidthRequest="240" HeightRequest="240" />

            <Ellipse x:Name="QuantumRing" Stroke="#ffffff" StrokeThickness="2" StrokeDashArray="1, 4" WidthRequest="160" HeightRequest="160" Opacity="0.8">
                <Ellipse.Shadow>
                    <Shadow Brush="#00e6ff" Radius="10" Opacity="1" />
                </Ellipse.Shadow>
            </Ellipse>

            <Polygon x:Name="GlitchCyan" Points="40,0 80,20 80,65 40,85 0,65 0,20" Fill="#00ffff" Opacity="0" TranslationX="-4" TranslationY="3" WidthRequest="80" HeightRequest="85" HorizontalOptions="Center" VerticalOptions="Center" />
            <Polygon x:Name="GlitchRed" Points="40,0 80,20 80,65 40,85 0,65 0,20" Fill="#ff0055" Opacity="0" TranslationX="4" TranslationY="-3" WidthRequest="80" HeightRequest="85" HorizontalOptions="Center" VerticalOptions="Center" />

            <Polygon x:Name="MainCore" Points="40,0 80,20 80,65 40,85 0,65 0,20" Fill="#ffffff" WidthRequest="80" HeightRequest="85" HorizontalOptions="Center" VerticalOptions="Center">
                <Polygon.Shadow>
                    <Shadow Brush="#ffffff" Radius="40" Opacity="1" />
                </Polygon.Shadow>
            </Polygon>

            <Ellipse x:Name="SonarRipple1" Stroke="#00e6ff" StrokeThickness="4" WidthRequest="80" HeightRequest="80" Opacity="0" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Ellipse x:Name="SonarRipple2" Stroke="#00e6ff" StrokeThickness="2" WidthRequest="80" HeightRequest="80" Opacity="0" HorizontalOptions="Center" VerticalOptions="Center"/>

        </Grid>
        <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Margin="0,0,0,50" Spacing="20">

            <Label x:Name="TranscriptLabel" Text="Awaiting initialization..." TextColor="#00e6ff" FontFamily="Consolas" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="3" LineBreakMode="WordWrap" WidthRequest="320"/>

        </VerticalStackLayout>

    </Grid>
</ContentPage>
