<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"            
             Shell.NavBarIsVisible="False"
             Shell.BackgroundColor="Transparent"
             Shell.PresentationMode="NotAnimated"
             BackgroundColor="#01050a"
             x:Class="Jarvis.MainPage">
    <Grid BackgroundColor="#01050a">
        <!-- BACKGROUND LAYER: NEBULA GLOW -->
        <Ellipse Fill="#00152b" WidthRequest="600" HeightRequest="600" VerticalOptions="Center" HorizontalOptions="Center" Opacity="0.4">
           
        </Ellipse>

        <!-- GRID OVERLAY (Futuristic HUD look) -->
        <Grid Opacity="0.1" InputTransparent="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            
            <Rectangle Grid.Row="1" Grid.Column="1" Stroke="#00fbff" StrokeThickness="0.5" Fill="Transparent" />
            <BoxView Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" WidthRequest="0.5" Color="#00fbff" HorizontalOptions="Center" />
            <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="0.5" Color="#00fbff" VerticalOptions="Center" />
        </Grid>

        <!-- SCANNING LINE ELEMENT -->
        <BoxView x:Name="ScannerLine" HeightRequest="1" WidthRequest="600" VerticalOptions="Start" HorizontalOptions="Center" Color="#00fbff" Opacity="0.5">
            <BoxView.Shadow>
                <Shadow Brush="#00fbff" Radius="20" Opacity="0.8" Offset="0,0" />
            </BoxView.Shadow>
        </BoxView>

        <Grid RowDefinitions="*, 250">
            
            <!-- TOP SECTION: THE ARC REACTOR (Centerpiece) -->
            <Grid Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center">
                
                <!-- OUTER ORBITAL RINGS -->
                <Ellipse x:Name="HoloGlow" Fill="#00e6ff" Opacity="0.03" WidthRequest="450" HeightRequest="450" />
                
                <Ellipse x:Name="DataRing1" Stroke="#00fbff" StrokeThickness="1" StrokeDashArray="1, 15" WidthRequest="380" HeightRequest="380" Opacity="0.2"/>
                <Ellipse x:Name="DataRing2" Stroke="#00fbff" StrokeThickness="2" StrokeDashArray="40, 10" WidthRequest="340" HeightRequest="340" Opacity="0.4"/>
                
                <Ellipse Stroke="#003366" StrokeThickness="8" WidthRequest="300" HeightRequest="300" Opacity="0.3"/>
                <Ellipse x:Name="QuantumRing" Stroke="#00fbff" StrokeThickness="4" StrokeDashArray="2, 4" WidthRequest="280" HeightRequest="280">
                    <Ellipse.Shadow>
                        <Shadow Brush="#00fbff" Radius="15" Opacity="0.6" />
                    </Ellipse.Shadow>
                </Ellipse>

                <!-- INNER TECHNICAL RINGS -->
                <Ellipse x:Name="InnerRing1" Stroke="#ffcc00" StrokeThickness="1" StrokeDashArray="5, 60" WidthRequest="220" HeightRequest="220" Opacity="0.6" />
                <Ellipse x:Name="InnerRing2" Stroke="#00fbff" StrokeThickness="2" StrokeDashArray="10, 5, 2, 5" WidthRequest="200" HeightRequest="200" Opacity="0.8" />

                <!-- THE CORE (Mark 85 Style) -->
                <Grid WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" VerticalOptions="Center">
                    <Ellipse Fill="#ffffff" Opacity="0.1" />
                    
                    <Polygon x:Name="GlitchCyan" Points="40,0 80,20 80,65 40,85 0,65 0,20" Fill="#00ffff" Opacity="0" TranslationX="-4" TranslationY="3" WidthRequest="80" HeightRequest="85" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Polygon x:Name="GlitchRed" Points="40,0 80,20 80,65 40,85 0,65 0,20" Fill="#ff0055" Opacity="0" TranslationX="4" TranslationY="-3" WidthRequest="80" HeightRequest="85" HorizontalOptions="Center" VerticalOptions="Center" />

                    <Polygon x:Name="MainCore" Points="40,0 80,20 80,65 40,85 0,65 0,20" Fill="#ffffff" WidthRequest="80" HeightRequest="85" HorizontalOptions="Center" VerticalOptions="Center">
                        <Polygon.Shadow>
                            <Shadow Brush="#ffffff" Radius="50" Opacity="1" />
                        </Polygon.Shadow>
                    </Polygon>

                    <Ellipse x:Name="SonarRipple1" Stroke="#00fbff" StrokeThickness="6" WidthRequest="80" HeightRequest="80" Opacity="0" />
                    <Ellipse x:Name="SonarRipple2" Stroke="#00fbff" StrokeThickness="3" WidthRequest="80" HeightRequest="80" Opacity="0" />
                </Grid>
            </Grid>

            <!-- BOTTOM SECTION: GLASS HUD CHAT -->
            <Grid Grid.Row="1" Margin="20,0,20,20">
                <Border BackgroundColor="#0A1F33" Stroke="#003366" StrokeThickness="2" Opacity="0.85" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20,0,20,0" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#00fbff" Radius="15" Opacity="0.3" Offset="0,0" />
                    </Border.Shadow>
                    
                    <Grid RowDefinitions="*, Auto">
                        <!-- History Area -->
                        <CollectionView x:Name="HistoryView" Grid.Row="0" Margin="15,15,15,5" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Role}" TextColor="#00fbff" FontSize="9" CharacterSpacing="2" FontAttributes="Bold" />
                                        <Label Text="{Binding Message}" TextColor="#e0faff" FontSize="13" LineBreakMode="WordWrap" />
                                        <BoxView HeightRequest="0.5" Color="#1A3A5A" Margin="0,4,0,0"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Live Status Area -->
                        <VerticalStackLayout Grid.Row="1" BackgroundColor="#0D2A47" Padding="15,10">
                            <Label x:Name="TranscriptLabel" 
                                   Text="CALIBRATING SYSTEMS..." 
                                   TextColor="#00fbff" 
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   CharacterSpacing="1"
                                   HorizontalOptions="Center" 
                                   HorizontalTextAlignment="Center" 
                                   MaxLines="2"/>
                            <BoxView HeightRequest="2" WidthRequest="50" Color="#ffcc00" HorizontalOptions="Center" Margin="0,5,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
        
        <!-- TOP HUD INFO -->
        <HorizontalStackLayout VerticalOptions="Start" HorizontalOptions="Start" Padding="25,45" Spacing="15" InputTransparent="True">
            <VerticalStackLayout>
                <Label Text="CORE STATUS: STABLE" TextColor="#00fbff" FontSize="9" CharacterSpacing="1"/>
                <Label Text="VIRTUAL ASSISTANT: JARVIS" TextColor="#ffcc00" FontSize="10" FontAttributes="Bold"/>
            </VerticalStackLayout>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
